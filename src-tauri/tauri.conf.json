{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "HiveMe",
  "mainBinaryName": "hmg",
  "version": "0.1.0",
  "identifier": "com.caoccao.hiveme",
  "build": {
    "beforeDevCommand": "cargo build -r -p hmc && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build -r -p hmc && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HiveMe",
        "width": 1200,
        "height": 900,
        "minWidth": 600,
        "minHeight": 450,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/bin/hmc": "../target/release/hmc"
        }
      },
      "deb": {
        "files": {
          "/usr/bin/hmc": "../target/release/hmc"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/hmc": "../target/release/hmc"
        }
      }
    },
    "macOS": {
      "files": {
        "MacOS/hmc": "../target/release/hmc"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "English",
          "German",
          "Spanish",
          "French",
          "Italian",
          "Japanese",
          "SimpChinese",
          "TradChinese"
        ]
      },
      "wix": {
        "language": [
          "en-US",
          "de-DE",
          "es-ES",
          "fr-FR",
          "it-IT",
          "ja-JP",
          "zh-CN",
          "zh-TW"
        ]
      }
    }
  }
}
